# ===================================================================
# SkillMatrix Environment Configuration (.env.example)
# ===================================================================

# Node Environment: development | production | test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# -------------------------------------------------------------------
# Database Connection (Microsoft SQL Server)
# Format: sqlserver://[HOST]:[PORT];database=[DB];user=[USER];password=[PASS];encrypt=[true/false];trustServerCertificate=[true/false]
# Or Integrated Security (Windows): sqlserver://localhost;instanceName=SQLEXPRESS;database=skillmatrix;integratedSecurity=true;trustServerCertificate=true;
# -------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillmatrix?schema=public"

# -------------------------------------------------------------------
# Security & Authentication
# -------------------------------------------------------------------
# Secret used for session token signing (min 32 chars in production)
SESSION_SECRET="change-this-to-a-very-secure-random-32-char-string-in-production"
SESSION_EXPIRES_IN_HOURS=24
COOKIE_SECURE=false

# Account Lockout Policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Initial Admin Bootstrap (Used during initial setup if no admin exists)
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_LOGIN_ID=admin
ADMIN_BOOTSTRAP_PASSWORD=AdminPassword123!
ADMIN_BOOTSTRAP_NAME="System Administrator"
ADMIN_BOOTSTRAP_EMAIL=admin@skillmatrix.local

# -------------------------------------------------------------------
# File Storage
# -------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=10485760

# -------------------------------------------------------------------
# Client URL (For CORS / CSRF verification)
# -------------------------------------------------------------------
CLIENT_ORIGIN="http://localhost:5173"
